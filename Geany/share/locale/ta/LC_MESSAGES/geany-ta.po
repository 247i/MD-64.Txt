msgid "Always show virtual spaces beyond the end of lines"
msgstr "வரிகளின் முடிவிற்கு அப்பால் எப்போதும் மெய்நிகர் இடைவெளிகளைக் காட்டுங்கள்"

#: ../data/geany.glade.h:156
msgid "<b>Virtual spaces</b>"
msgstr "<b> மெய்நிகர் இடங்கள் </b>"

