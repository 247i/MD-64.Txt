; PSPad clip definition file for LSL (Linden Scripting Language)
; https://wiki.secondlife.com/wiki/LSL_Portal
; Author: Torsten Funk
; Last Revision: 2026-01-23

[Macro definition]
; Help file > Working with PSPad > Context Files > Interactive Clips
; Format; 	%control%=@x caption,text,default,options,delimiter,dialog_type
%avatar%=@E Avatar (key):
%end%=@E End (integer):
%color%=@L Color:,,"<1.0, 1.0, 1.0>",,"
%id%=@E Id (key):
%link%=@E Link ID (integer):
%src%=@E Source:,,,,",
%start%=@E Start (integer):
%string%=@E String:,,,,",
%message%=@E Message (string):,,,,",
%user%=@E User (key):
%val%=@E Integer:

; EVENTS
[attach | Triggered in an object when the object attaches or detaches from agent.]
attach(key id) {
    |
}
[at_rot_target | Result of llRotTarget library function call.]
at_rot_target(integer handle, rotation targetrot, rotation ourrot) {
    |
}
[at_target | Result of llTarget library function call.]
at_target(integer tnum, vector targetpos, vector ourpos) {
    |
}
[changed | Various changes to the object/prim trigger this event.]
changed(integer change) {
    |
}
[collision | Triggered while task is colliding with another task.]
collision(integer num_detected) {
    |
}
[collision_end | Triggered when task stops colliding with another task.]
collision_end(integer num_detected) {
    |
}
[collision_start | Triggered when task starts colliding with another task]
collision_start(integer num_detected) {
    |
}
[control | Result of llTakeControls library function call and user input.]
control(key id, integer level, integer edge) {
    |
}
[dataserver | Triggered when task receives asynchronous data.]
dataserver(key queryid, string data) {
    |
}
[email | Triggered as a result of calling llGetNextEmail where there is a matching email in the email queue.]
email(string time, string address, string subject, string message, integer num_left) {
    |
}
[experience_permissions | The agent has approved an experience permissions request.]
experience_permissions(key agent_id) {
    |
}
[experience_permissions_denied | The agent has denied experience permission.]
experience_permissions_denied(key agent_id, integer reason) {
    |
}
[Final damage | Triggered after all on_damage events in all scripts and attachments.]
final_damage(integer num_detected) {
    |
}
[game_control | Triggered when compatible viewer sends fresh GameControlInput message, but only for scripts on attachments or seat.]
game_control(key id, integer button_levels, list axes) {
    |
}
[http_request | Triggered when task receives an HTTP request.]
http_request(key request_id, string method, string body) {
    |
}
[http_response | Triggered when task receives a response to one of its llHTTPRequests.]
http_response(key request_id, integer status, list metadata, string body) {
    |
}
[land_collision | Triggered in the root when physical object or attached avatar is colliding with land.]
land_collision(vector pos) {
    |
}
[land_collision_end | Triggered in the root when a physical object or attached avatar stops colliding with land.]
land_collision_end(vector pos) {
    |
}
[land_collision_start | Triggered in the root when a physical object or attached avatar starts colliding with land.]
land_collision_start(vector pos) {
    |
}
[linkset_data | The linkset_data event fires in all scripts in a linkset whenever the datastore has been modified through a call to one of the llLinksetData functions.]
linkset_data(integer action, string name, string value) {
    |
}
[link_message | Triggered when the script receives a link message that was sent by a call to llMessageLinked. llMessageLinked is used to send messages from one script to another.]
link_message(integer sender_num, integer num, string str, key id) {
    |
}
[listen | Triggered by chat, use llListen to enable and filter.]
listen(integer channel, string name, key id, string message) {
    |
}
[money | Triggered when money is paid to the prim in the amount by id.]
money(key id, integer amount) {
    |
}
[moving_end | Triggered when task stops moving]
moving_end() {
    |
}
[moving_start | Triggered when task begins moving]
moving_start() {
    |
}
[not_at_rot_target | Result of llRotTarget library function call.]
not_at_rot_target() {
    |
}
[not_at_target | Triggered if an object has not yet reached the target set by the call to llTarget.]
not_at_target() {
    |
}
[no_sensor | Result of a call to llSensor or llSensorRepeat.]
no_sensor() {
    |
}
[object_rez | Triggered when the object rezzes an object.]
object_rez(key id) {
    |
}
[on_death | This event is triggered on all attachments worn by an avatar when that avatar's health reaches 0.]
on_death() {
    |
}
[on_damage | This event is triggered when damage has been inflicted on an avatar or task in the world but before damage has been applied or distributed.]
on_damage(integer num_detected) {
    |
}
[on_rez | Triggered when an object is rezzed (by script or by user). Also triggered in attachments when a user logs in, or when the object is attached from inventory.]
on_rez(integer start_param) {
    |
}
[path_update | --unknown---]
path_update(integer type, list reserved) {
    |
}
[run_time_permissions | Triggered when an agent grants run time permissions to this script.]
run_time_permissions(integer perm) {
    |
}
[sensor | Results from a call to either llSensor or llSensorRepeat.]
sensor(integer num_detected) {
    |
}
[state_entry | Triggered on any state transition and startup.]
state_entry() {
    |
}
[state_exit | Triggered on a qualifying state transition.]
state_exit() {
    |
}
[timer | Repeats the code in the timer(). Result of the llSetTimerEvent library function call.]
timer() {
    |
}
[touch | Triggered whilst an agent is clicking the task.]
touch(integer num_detected) {
    |
}
[touch_end | Triggered when agent stops clicking on task.]
touch_end(integer num_detected) {
    |
}
[touch_start | Triggered by the start of agent clicking on task.]
touch_start(integer num_detected) {
    |
}
[transaction_result | Triggered when task receives asynchronous data.]
transaction_result(key id, integer success, string data) {
    |
}

; FUNCTIONS
; Help file > Working with PSPad > Context Files > Clips
; Format [name |x description]*shortcut
[llSin | Returns the sine of theta (theta in radians)]
llSin(float theta)|
[llCos | Returns the cosine of theta (theta in radians)]
llCos(float theta)|
[llTan | Returns the tangent of theta (theta in radians)]
llTan(float theta)|
[llAtan2 | Returns the arctangent2 of y, x]
llAtan2(float y, float x)|
[llSqrt | Returns the square root of val, or returns 0 and triggers a Math Error for imaginary results]
llSqrt(float val)|
[llPow | Returns the base raised to the power exponent, or returns 0 and triggers Math Error for imaginary results]
llPow(float base, float exponent)|
[llAbs | Returns the positive version of val]
llAbs(integer val)|
[llFabs | Returns the positive version of val]
llFabs(float val)|
[llFrand | Returns a pseudo random number in the range [0,mag) or (mag,0]]
llFrand(float mag)|
[llFloor | Returns largest integer value <= val]
llFloor(float val)|
[llCeil | Returns smallest integer value >= val]
llCeil(float val)|
[llRound | Returns val rounded to the nearest integer]
llRound(float val)|
[llVecMag | Returns the magnitude of v]
llVecMag(vector v)|
[llVecNorm | Returns the v normalized]
llVecNorm(vector v)|
[llVecDist | Returns the 3D distance between v1 and v2]
llVecDist(vector v1, vector v2)|
[llRot2Euler | Returns the Euler representation (roll, pitch, yaw) of q]
llRot2Euler(rotation q)|
[llEuler2Rot | Returns the rotation representation of Euler Angles v]
llEuler2Rot(vector v)|
[llAxes2Rot | Returns the rotation defined by the coordinate axes]
llAxes2Rot(vector fwd, vector left, vector up)|
[llRot2Fwd | Returns the forward vector defined by q]
llRot2Fwd(rotation q)|
[llRot2Left | Returns the left vector defined by q]
llRot2Left(rotation q)|
[llRot2Up | Returns the up vector defined by q]
llRot2Up(rotation q)|
[llRotBetween | Returns the rotation to rotate v1 to v2]
llRotBetween(vector v1, vector v2)|
[llWhisper | Whispers the text of msg on channel]
llWhisper(integer channel, string msg)|
[llSay | Says the text of msg on channel]
llSay(integer channel, string msg)|
[llShout | Shouts the text of msg on channel]
llShout(integer channel, string msg)|
[llListen | Sets a callback for msg on channel from name and id (name, id, and/or msg can be empty) and returns an identifier that can be used to deactivate or remove the listen]
llListen(integer channel, string name, key id, string msg)|
[llListenControl | Makes a listen event callback active or inactive]
llListenControl(integer number, integer active)|
[llListenRemove | Removes listen event callback number]
llListenRemove(integer number)|
[llSensor | Performs a single scan for name and id with type (AGENT, ACTIVE, PASSIVE, and/or SCRIPTED) within range meters and arc radians of forward vector (name, id, and/or keytype can be empty or 0)]
llSensor(string name, key id, integer type, float range, float arc)|
[llSensorRepeat | Sets a callback for name and id with type (AGENT, ACTIVE, PASSIVE, and/or SCRIPTED) within range meters and arc radians of forward vector (name, id, and/or keytype can be empty or 0) and repeats every rate seconds]
llSensorRepeat(string name, key id, integer type, float range, float arc, float rate)|
[llSensorRemove | Removes the sensor setup by llSensorRepeat]
llSensorRemove()|
[llDetectedName | Returns the name of detected object number (returns empty string if number is not a valid sensed object)]
llDetectedName(integer number)|
[llDetectedKey | Returns the key of detected object number (returns empty key if number is not a valid sensed object)]
llDetectedKey(integer number)|
[llDetectedOwner | Returns the key of detected object's owner (returns empty key if number is not a valid sensed object)]
llDetectedOwner(integer number)|
[llDetectedType | Returns the type (AGENT, ACTIVE, PASSIVE, SCRIPTED) of detected object (returns 0 if number is not a valid sensed object)]
llDetectedType(integer number)|
[llDetectedPos | Returns the position of detected object number (returns <0,0,0> if number is not a valid sensed object)]
llDetectedPos(integer number)|
[llDetectedVel | Returns the velocity of detected object number (returns <0,0,0> if number is not a valid sensed object)]
llDetectedVel(integer number)|
[llDetectedGrab | Returns the grab offset of the user touching object (returns <0,0,0> if number is not a valid sensed object)]
llDetectedGrab(integer number)|
[llDetectedRot | Returns the rotation of detected object number (returns <0,0,0,1> if number is not a valid sensed object)]
llDetectedRot(integer number)|
[llDetectedGroup | Returns TRUE if detected object is part of same group as owner]
llDetectedGroup(integer number)|
[llDetectedLinkNumber | Returns the link position of the triggered event for touches and collisions only]
llDetectedLinkNumber(integer number)|
[llDie | Deletes the object]
llDie()|
[llGround | Returns the ground height below the object position + offset]
llGround(vector offset)|
[llCloud | (DEPRECATED) It always returns 0.0 now.Returns the cloud density at the object position + offset.]
llCloud(vector offset)|
[llWind | Returns the wind velocity at the object position + offset]
llWind(vector offset)|
[llSetStatus | Sets status (STATUS_PHYSICS, STATUS_PHANTOM, STATUS_BLOCK_GRAB, STATUS_ROTATE_X, STATUS_ROTATE_Y, and/or STATUS_ROTATE_Z) to value]
llSetStatus(integer status, integer value)|
[llGetStatus | Returns value of status (STATUS_PHYSICS, STATUS_PHANTOM, STATUS_BLOCK_GRAB, STATUS_ROTATE_X, STATUS_ROTATE_Y, and/or STATUS_ROTATE_Z)]
llGetStatus(integer status)|
[llSetScale | Sets the scale of the prim]
llSetScale(vector scale)|
[llGetScale | Returns the scale of the prim]
llGetScale()|
[llSetColor | Sets the color on face of the prim]
llSetColor(vector color, integer face)|
[llGetAlpha | Returns the alpha of face]
llGetAlpha(integer face)|
[llSetAlpha | Sets the alpha on face]
llSetAlpha(float alpha, integer face)|
[llGetColor | Returns the color on face]
llGetColor(integer face)|
[llSetTexture | Sets the texture of face or ALL_SIDES]
llSetTexture(string texture, integer face)|
[llScaleTexture | Sets the texture u & v scales for the chosen face or ALL_SIDES]
llScaleTexture(float u, float v, integer face)|
[llOffsetTexture | Sets the texture u  & v offsets for the chosen face or ALL_SIDES]
llOffsetTexture(float u, float v, integer face)|
[llRotateTexture | Sets the texture rotation for the chosen face]
llRotateTexture(float angle, integer face)|
[llGetTexture | Returns a string that is the texture on face (the inventory name if it is a texture in the prim's inventory, otherwise the key)]
llGetTexture(integer face)|
[llSetPos | Moves the object or prim towards pos without using physics (if the script isn't physical)]
llSetPos(vector pos)|
[llGetPos | Returns the position of the task in region coordinates]
llGetPos()|
[llGetLocalPos | Returns the position relative to the root]
llGetLocalPos()|
[llSetRot | Sets the rotation]
llSetRot(rotation rot)|
[llGetRot | Returns the rotation relative to the region's axes]
llGetRot()|
[llGetLocalRot | Returns the rotation local to the root]
llGetLocalRot()|
[llSetForce | Applies force to the object (if the script is physical), in local coords if local == TRUE]
llSetForce(vector force, integer local)|
[llGetForce | Returns the force (if the script is physical)]
llGetForce()|
[llTarget | Sets positions within range of position as a target and return an ID for the target]
llTarget(vector position, float range)|
[llTargetRemove | Removes positional target number registered with llTarget]
llTargetRemove(integer number)|
[llRotTarget | Set rotations with error of rot as a rotational target and return an ID for the rotational target]
llRotTarget(rotation rot, float error)|
[llRotTargetRemove | Removes rotational target number registered with llRotTarget]
llRotTargetRemove(integer number)|
[llMoveToTarget | Critically damps to target in tau seconds (if the script is physical)]
llMoveToTarget(vector target, float tau)|
[llStopMoveToTarget | Stops critically damped motion]
llStopMoveToTarget()|
[llApplyImpulse | Applies impulse to object (if the script is physical), in local coords if local == TRUE]
llApplyImpulse(vector force, integer local)|
[llApplyRotationalImpulse | Applies rotational impulse to object (if the script is physical), in local coords if local == TRUE]
llApplyRotationalImpulse(vector force, integer local)|
[llSetTorque | Sets the torque of object (if the script is physical), in local coords if local == TRUE]
llSetTorque(vector torque, integer local)|
[llGetTorque | Returns the torque (if the script is physical)]
llGetTorque()|
[llSetForceAndTorque | Sets the force and torque of object (if the script is physical), in local coords if local == TRUE]
llSetForceAndTorque(vector force, vector torque, integer local)|
[llGetVel | Returns the velocity of the object]
llGetVel()|
[llGetAccel | Returns the acceleration of the object relative to the region's axes]
llGetAccel()|
[llGetOmega | Returns the rotation velocity in radians per second]
llGetOmega()|
[llGetTimeOfDay | Returns the time in seconds since [CURRENT_GRID] server midnight or since region up-time, whichever is smaller]
llGetTimeOfDay()|
[llGetWallclock | Returns the time in seconds since midnight California Pacific time (PST/PDT)]
llGetWallclock()|
[llGetTime | Returns the time in seconds since the last region reset, script reset, or call to either llResetTime or llGetAndResetTime]
llGetTime()|
[llResetTime | Sets the script timer to zero]
llResetTime()|
[llGetAndResetTime | Returns the script time in seconds and then resets the script timer to zero]
llGetAndResetTime()|
[llSound | (DEPRECATED) Use llPlaySound / llLoopSound / llSetSoundQueueing.Plays sound at volume and whether it should loop or not.]
llSound(string sound, float volume, integer queue, integer loop)|
[llPlaySound | Plays attached sound once at volume (0.0 - 1.0)]
llPlaySound(string sound, float volume)|
[llLoopSound | Plays attached sound looping indefinitely at volume (0.0 - 1.0)]
llLoopSound(string sound, float volume)|
[llLoopSoundMaster | Plays attached sound looping at volume (0.0 - 1.0), declares it a sync master]
llLoopSoundMaster(string sound, float volume)|
[llLoopSoundSlave | Plays attached sound looping at volume (0.0 - 1.0), synced to most audible sync master]
llLoopSoundSlave(string sound, float volume)|
[llPlaySoundSlave | Plays attached sound once at volume (0.0 - 1.0), synced to next loop of most audible sync master]
llPlaySoundSlave(string sound, float volume)|
[llTriggerSound | Plays sound at volume (0.0 - 1.0), centered at but not attached to object]
llTriggerSound(string sound, float volume)|
[llStopSound | Stops currently attached sound]
llStopSound()|
[llPreloadSound | Preloads a sound on viewers within range]
llPreloadSound(string sound)|
[llGetSubString | Returns the indicated substring]
llGetSubString(string src, integer start, integer end)|
[llDeleteSubString | Removes the indicated substring and returns the result]
llDeleteSubString(string src, integer start, integer end)|
[llInsertString | Returns a destination string dst with the string src inserted starting at position pos]
llInsertString(string dst, integer position, string src)|
[llToUpper | Returns a string that is src with all upper-case characters]
llToUpper(string src)|
[llToLower | Returns a string that is src with all lower-case characters]
llToLower(string src)|
[llGiveMoney | Transfers amount of L$ from script owner to destination]
llGiveMoney(key destination, integer amount)|
[llMakeExplosion | (DEPRECATED) Makes a round explosion of particles]
llMakeExplosion(integer particles, float scale, float vel, float lifetime, float arc, string texture, vector offset)|
[llMakeFountain | (DEPRECATED) Makes a fountain of particles]
llMakeFountain(integer particles, float scale, float vel, float lifetime, float arc, integer bounce, string texture, vector offset, float bounce_offset)|
[llMakeSmoke | (DEPRECATED) Makes smoke like particles]
llMakeSmoke(integer particles, float scale, float vel, float lifetime, float arc, string texture, vector offset)|
[llMakeFire | (DEPRECATED) Makes fire like particles]
llMakeFire(integer particles, float scale, float vel, float lifetime, float arc, string texture, vector offset)|
[llRezObject | Instantiates owner's inventory object at pos with velocity vel and rotation rot with start parameter param]
llRezObject(string inventory, vector pos, vector vel, rotation rot, integer param)|
[llLookAt | Causes object to point its up axis (positive z) towards target, while keeping its forward axis (positive x) below the horizon]
llLookAt(vector target, float strength, float damping)|
[llLinkLookAt | Causes a linked prim to point its up axis (positive z) towards target, while keeping its forward axis (positive x) below the horizon]
llLinkLookAt(integer link, vector target, float strength, float damping)|
[llStopLookAt | Stops causing object to point at a target]
llStopLookAt()|
[llSetTimerEvent | Causes the timer event to be triggered a maximum of once every sec seconds]
llSetTimerEvent(float sec)|
[llSleep | Puts the script to sleep for sec seconds]
llSleep(float sec)|
[llGetMass | Returns the mass of object that the script is attached to]
llGetMass()|
[llCollisionFilter | Sets the collision filter, exclusively or inclusively. If accept == TRUE, only accept collisions with objects name and id (either is optional), otherwise with objects not name or id.]
llCollisionFilter(string name, key id, integer accept)|
[llTakeControls | Allows for intercepting keyboard and mouse clicks from the agent the script has permissions for]
llTakeControls(integer controls, integer accept, integer pass_on)|
[llReleaseControls | Stops taking inputs that were taken with llTakeControls]
llReleaseControls()|
[llAttachToAvatar | Attaches the object to the avatar who has granted permission to the script]
llAttachToAvatar(integer attach_point)|
[llDetachFromAvatar | Detaches object from avatar]
llDetachFromAvatar()|
[llTakeCamera | (DEPRECATED) Use llSetCameraParams instead.Moves avatar's viewpoint to task.]
llTakeCamera(key avatar)|
[llReleaseCamera | (DEPRECATED) Use llClearCameraParams instead.Returns camera to agent avatar.]
llReleaseCamera(key avatar)|
[llGetOwner | Returns the object owner's UUID]
llGetOwner()|
[llInstantMessage | Sends the specified string as an Instant Message to the user]
llInstantMessage(key user, string message)|
[llEmail | Sends an email to address with the subject and message]
llEmail(string address, string subject, string message)|
[llGetNextEmail | Gets the next waiting email that comes from address, with specified subject]
llGetNextEmail(string address, string subject)|
[llGetKey | Returns the key of the prim the script is attached to]
llGetKey()|
[llSetBuoyancy | Sets the buoyancy of the task or object (0 is disabled, < 1.0 sinks, 1.0 floats, > 1.0 rises)]
llSetBuoyancy(float buoyancy)|
[llSetHoverHeight | Critically damps to a height above the ground (or water) in tau seconds]
llSetHoverHeight(float height, integer water, float tau)|
[llStopHover | Stops hovering to a height]
llStopHover()|
[llMinEventDelay | Sets the minimum time between events being handled]
llMinEventDelay(float delay)|
[llSoundPreload | (DEPRECATED) Use llPreloadSound.Preloads a sound on viewers within range]
llSoundPreload(string sound)|
[llRotLookAt | Causes object to point its forward axis towards target]
llRotLookAt(rotation target, float strength, float damping)|
[llLinkRotLookAt | Causes linked prim to point its forward axis towards target]
llLinkRotLookAt(integer link, rotation target, float strength, float damping)|
[llStringLength | Returns the length of string]
llStringLength(string str)|
[llStartAnimation | Starts animation anim for agent that granted PERMISSION_TRIGGER_ANIMATION if the permission has not been revoked]
llStartAnimation(string anim)|
[llStopAnimation | Stops animation anim for agent that granted permission]
llStopAnimation(string anim)|
[llPointAt | Makes agent that owns object point at pos]
llPointAt(vector pos)|
[llStopPointAt | Stops pointing agent that owns object]
llStopPointAt()|
[llTargetOmega | Rotates the object around axis at spinrate with strength gain]
llTargetOmega(vector axis, float spinrate, float gain)|
[llGetStartParameter | Returns an integer that is the script start/rez parameter]
llGetStartParameter()|
[llGodLikeRezObject | Rezzes directly off of UUID if owner is in God Mode]
llGodLikeRezObject(key inventory, vector pos)|
[llRequestPermissions | Asks the agent for permission to run certain classes of functions]
llRequestPermissions(key agent, integer perm)|
[llGetPermissionsKey | Returns the key of the avatar that last granted permissions to the script]
llGetPermissionsKey()|
[llGetPermissions | Returns an integer bitfield with the permissions that have been granted]
llGetPermissions()|
[llGetLinkNumber | Returns the link number of the prim containing the script (0 means not linked, 1 the prim is the root, 2 the prim is the first child, etc)]
llGetLinkNumber()|
[llSetLinkColor | Sets face to color if a task exists in the link chain at linknumber]
llSetLinkColor(integer linknumber, vector color, integer face)|
[llCreateLink | Attempts to link the script's object with the target (requires that PERMISSION_CHANGE_LINKS be granted). If parent == TRUE, then the script's object becomes the root.]
llCreateLink(key target, integer parent)|
[llBreakLink | Delinks the prim with the given link number in a linked object set (requires that PERMISSION_CHANGE_LINKS be granted)]
llBreakLink(integer linknum)|
[llBreakAllLinks | Delinks all prims in the link set (requires that PERMISSION_CHANGE_LINKS be granted)]
llBreakAllLinks()|
[llGetLinkKey | Returns the key of the linked prim linknumber]
llGetLinkKey(integer linknumber)|
[llGetLinkName | Returns the name of linknumber in a link set]
llGetLinkName(integer linknumber)|
[llGetInventoryNumber | Returns the number of items of a given type (INVENTORY_* flag) in the prim's inventory]
llGetInventoryNumber(integer type)|
[llGetInventoryName | Returns the name of the inventory item number of a given type]
llGetInventoryName(integer type, integer number)|
[llSetScriptState | Sets the running state of the specified script]
llSetScriptState(string name, integer run)|
[llGetEnergy | Returns how much energy is in the object as a percentage of maximum]
llGetEnergy()|
[llGiveInventory | Gives inventory to destination.Sleeps script for 2 seconds if destination is an avatar.]
llGiveInventory(key destination, string inventory)|
[llRemoveInventory | Removes the named inventory item]
llRemoveInventory(string item)|
[llSetText | Displays text that hovers over the prim with specific color and translucency specified with alpha]
llSetText(string text, vector color, float alpha)|
[llWater | Returns the water height below the object position + offset]
llWater(vector offset)|
[llPassTouches | If pass == TRUE, touches are passed from children on to parents]
llPassTouches(integer pass)|
[llRequestAgentData | Requests data about agent id. When data is available the dataserver event will be raised.]
llRequestAgentData(key id, integer data)|
[llRequestInventoryData | Requests data from object's inventory object. When data is available the dataserver event will be raised.]
llRequestInventoryData(string name)|
[llSetDamage | Sets the amount of damage that will be done when this object hits an avatar]
llSetDamage(float damage)|
[llTeleportAgentHome | Teleports avatar on the owner's land to their home location without any warning]
llTeleportAgentHome(key id)|
[llModifyLand | Modifies land using the specified action on the specified brush size of land]
llModifyLand(integer action, integer brush)|
[llCollisionSound | Suppresses default collision sounds, replaces default impact sounds with impact_sound at the volume impact_volume]
llCollisionSound(string impact_sound, float impact_volume)|
[llCollisionSprite | Suppresses default collision sprites, replaces default impact sprite with impact_sprite (use an empty string to just suppress)]
llCollisionSprite(string impact_sprite)|
[llGetAnimation | Returns the name of the currently playing locomotion animation for avatar id]
llGetAnimation(key id)|
[llResetScript | Resets the script]
llResetScript()|
[llMessageLinked | Allows scripts in the same object to communicate. Triggers a link_message event with the same parameters num, str, and id in all scripts in the prim(s) described by linknum.]
llMessageLinked(integer linknum, integer num, string str, key id)|
[llPushObject | Applies impulse and ang_impulse to object id]
llPushObject(key id, vector impulse, vector ang_impulse, integer local)|
[llPassCollisions | If pass == TRUE, collisions are passed from children on to parents (default is FALSE)]
llPassCollisions(integer pass)|
[llGetScriptName | Returns the name of the script that this function is used in]
llGetScriptName()|
[llGetNumberOfSides | Returns the number of faces (or sides) of the prim]
llGetNumberOfSides()|
[llAxisAngle2Rot | Returns the rotation that is a generated angle about axis]
llAxisAngle2Rot(vector axis, float angle)|
[llRot2Axis | Returns the rotation axis represented by rot]
llRot2Axis(rotation rot)|
[llRot2Angle | Returns the rotation angle represented by rot]
llRot2Angle(rotation rot)|
